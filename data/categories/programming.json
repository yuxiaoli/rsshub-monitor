  {
    "provider_id": "github",
    "provider_name": "GitHub",
    "route_key": "/issue/:user/:repo/:state?/:labels?",
    "route": {
      "path": "/issue/:user/:repo/:state?/:labels?",
      "view": 5,
      "example": "/github/issue/DIYgod/RSSHub/open",
      "parameters": {
        "user": "GitHub username",
        "repo": "GitHub repo name",
        "state": {
          "description": "the state of the issues.",
          "default": "open",
          "options": [
            {
              "label": "Open",
              "value": "open"
            },
            {
              "label": "Closed",
              "value": "closed"
            },
            {
              "label": "All",
              "value": "all"
            }
          ]
        },
        "labels": "a list of comma separated label names"
      },
      "name": "Repo Issues",
      "provider_id": "github",
      "provider_name": "GitHub",
      "route_key": "/issue/:user/:repo/:state?/:labels?"
    }
  },
  {
    "provider_id": "github",
    "provider_name": "GitHub",
    "route_key": "/search/:query/:sort?/:order?",
