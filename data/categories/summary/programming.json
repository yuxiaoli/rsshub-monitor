            },
            {
              "value": "intrusion-daily-cyber-threat-alert",
              "label": "Cyberattacks"
            },
            {
              "value": "ransomware-minute",
              "label": "Ransomware"
            },
            {
              "value": "cryptocrime",
              "label": "Cryptocrime"
            },
            {
              "value": "hack-blotter",
              "label": "Hack Blotter"
            },
            {
              "value": "cybersecurity-venture-capital-vc-deals",
              "label": "VC Deal Flow"
            },
            {
              "value": "mergers-and-acquisitions-report",
              "label": "M&A Tracker"
            }
          ]
        }
      },
      "description": ""
    }
  },
