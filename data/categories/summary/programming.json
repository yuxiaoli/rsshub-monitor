[
  {
    "provider_id": "gihyo",
    "provider_name": "gihyo.jp",
    "route_key": "/list/group/:id",
    "route": {
      "name": "Series",
      "path": "/list/group/:id",
      "example": "/gihyo/list/group/Ubuntu-Weekly-Recipe",
      "parameters": {
        "id": "Series"
      },
      "description": ""
    }
  },
  {
    "provider_id": "gitee",
    "provider_name": "Gitee",
    "route_key": "/events/:owner/:repo",
    "route": {
      "name": "仓库动态",
      "path": "/events/:owner/:repo",
      "example": "/gitee/events/y_project/RuoYi",
      "parameters": {
        "owner": "用户名",
        "repo": "仓库名"
      },
      "description": ""
    }
  },
  {
    "provider_id": "github",
    "provider_name": "GitHub",
    "route_key": "/wiki/:user/:repo/:page?",
    "route": {
      "name": "Wiki History",
      "path": "/wiki/:user/:repo/:page?",
      "example": "/github/wiki/flutter/flutter/Roadmap",
      "parameters": {
        "user": "User / Org name",
        "repo": "Repo name",
        "page": "Page slug, can be found in URL, empty means Home"
      },
      "description": ""
    }
  },
  {
    "provider_id": "hackernews",
    "provider_name": "Hacker News",
    "route_key": "/:section?/:type?/:user?",
    "route": {
      "name": "User",
      "path": "/:section?/:type?/:user?",
      "example": "/hackernews/threads/comments_list/dang",
      "parameters": {
        "section": {
          "description": "Content section, default to `index`"
        },
        "type": {
          "description": "Link type, default to `sources`"
        },
        "user": {
          "description": "Set user, only valid in `threads` and `submitted` sections"
        }
      },
      "description": "Subscribe to the content of a specific user"
    }
  },
  {
    "provider_id": "issuehunt",
    "provider_name": "Issue Hunt",
    "route_key": "/funded/:username/:repo",
    "route": {
      "name": "Project Funded",
      "path": "/funded/:username/:repo",
      "example": "/issuehunt/funded/DIYgod/RSSHub",
      "parameters": {
        "username": "Github user/org",
        "repo": "Repository name"
      },
      "description": ""
    }
  }
]