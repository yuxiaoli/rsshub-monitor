      },
      "description": ""
    }
  },
  {
    "provider_id": "twitch",
    "provider_name": "Twitch",
    "route_key": "/video/:login/:filter?",
    "route": {
      "name": "Channel Video",
      "path": "/video/:login/:filter?",
      "example": "/twitch/video/riotgames/highlights",
      "parameters": {
        "login": "Twitch username",
        "filter": {
          "description": "Video type, Default to all",
          "options": [
            {
              "value": "archive",
              "label": "Archive"
            },
            {
              "value": "highlights",
              "label": "Highlights"
            },
            {
              "value": "all",
              "label": "All"
            }
          ],
          "default": "all"
        }
      },
      "description": ""
    }
  }
