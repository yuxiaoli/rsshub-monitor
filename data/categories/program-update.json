[
  {
    "provider_id": "android",
    "provider_name": "Android",
    "route_key": "/platform-tools-releases",
    "route": {
      "path": "/platform-tools-releases",
      "example": "/android/platform-tools-releases",
      "parameters": {},
      "name": "SDK Platform Tools release notes",
