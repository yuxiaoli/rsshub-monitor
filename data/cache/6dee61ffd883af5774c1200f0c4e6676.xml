                                            &lt;img src=&quot;https://news.now.com/nownews/NewsImage/2026-07-31-16-53-00EFOmaDCp.jpg&quot; alt=&quot;&quot; data-description=&quot;&quot; referrerpolicy=&quot;no-referrer&quot;&gt;
                                            &lt;meta itemprop=&quot;url&quot; content=&quot;https://news.now.com/nownews/NewsImage/2026-07-31-16-53-00EFOmaDCp.jpg&quot;&gt;
                                        &lt;/a&gt;
