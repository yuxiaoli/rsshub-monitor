                                        &lt;a href=&quot;https://news.now.com/nownews/NewsImage/2026-07-31-18-17-54xvTEGQvi.jpg&quot; rel=&quot;galleryCollection&quot; title=&quot;&quot;&gt;
                                            &lt;img src=&quot;https://news.now.com/nownews/NewsImage/2026-07-31-18-17-54xvTEGQvi.jpg&quot; alt=&quot;&quot; data-description=&quot;&quot; referrerpolicy=&quot;no-referrer&quot;&gt;
