&lt;p align=&quot;justify&quot; style=&quot;text-align: center;&quot;&gt;　　&lt;span&gt;&lt;span&gt;&lt;img alt=&quot;&quot; src=&quot;https://www.chinacdc.cn/zxyw/202508/W020250831668595118460.png&quot; oldsrc=&quot;W020250831668595118460.png&quot; referrerpolicy=&quot;no-referrer&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;
