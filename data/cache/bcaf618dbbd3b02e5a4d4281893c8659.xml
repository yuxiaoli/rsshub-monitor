&lt;p align=&quot;justify&quot; style=&quot;text-align: center;&quot;&gt;　　&lt;span&gt;&lt;span&gt;&lt;span&gt;&lt;span&gt;&lt;font face=&quot;仿宋&quot;&gt;开学典礼现场&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;
