&lt;pre&gt;&lt;code&gt;
			&amp;lt;div class=&quot;form-group&quot;&amp;gt;
				&amp;lt;label class=&quot;col-sm-3 control-label is-required&quot;&amp;gt;菜单类型：&amp;lt;/label&amp;gt;
				&amp;lt;div class=&quot;col-sm-8&quot;&amp;gt;
					&amp;lt;label class=&quot;radio-box&quot;&amp;gt; &amp;lt;input type=&quot;radio&quot; name=&quot;menuType&quot; value=&quot;M&quot; /&amp;gt; 目录 &amp;lt;/label&amp;gt; 
					&amp;lt;label class=&quot;radio-box&quot;&amp;gt; &amp;lt;input type=&quot;radio&quot; name=&quot;menuType&quot; value=&quot;C&quot; /&amp;gt; 菜单 &amp;lt;/label&amp;gt; 
					&amp;lt;label class=&quot;radio-box&quot;&amp;gt; &amp;lt;input type=&quot;radio&quot; name=&quot;menuType&quot; value=&quot;F&quot; /&amp;gt; 按钮 &amp;lt;/label&amp;gt;
				&amp;lt;/div&amp;gt;
			&amp;lt;/div&amp;gt;
&lt;/code&gt;&lt;/pre&gt;
&lt;pre&gt;&lt;code&gt;	$(&#39;input[name=&quot;menuType&quot;]&#39;).on(&#39;change&#39;, function() {
			var menuType =$(this).val();
			alert(&quot;---&quot;+menuType);
		});
&lt;/code&gt;&lt;/pre&gt;
&lt;p&gt;监听改变事件，打开页面首次选择菜单类型时触发一次。（再次改变菜单类型类型时会触发两次，第一次是改变之前选中的值，第二次才是当前选中的值。）&lt;/p&gt;
</description><link>https://gitee.com/y_project/RuoYi/issues/IJR2MV</link><guid isPermaLink="false">1510361791733760000</guid><pubDate>Sat, 30 May 2026 11:18:32 GMT</pubDate><author>shanshiquan_admin</author></item><item><title>honeytina starred y_project/RuoYi</title><description></description><link></link><guid isPermaLink="false">1510324340222889984</guid><pubDate>Sat, 30 May 2026 08:49:43 GMT</pubDate><author>honeytina</author></item><item><title>qaxylw starred y_project/RuoYi</title><description></description><link></link><guid isPermaLink="false">1510309421947576320</guid><pubDate>Sat, 30 May 2026 07:50:26 GMT</pubDate><author>qaxylw</author></item><item><title>xiaoZ1712 forked y_project/RuoYi</title><description></description><link>https://gitee.com/xiaoZ1712/RuoYi.git</link><guid isPermaLink="false">1510198441209077760</guid><pubDate>Sat, 30 May 2026 00:29:26 GMT</pubDate><author>xiaoZ1712</author></item><item><title>xiaoZ1712 starred y_project/RuoYi</title><description></description><link></link><guid isPermaLink="false">1510198419843186688</guid><pubDate>Sat, 30 May 2026 00:29:21 GMT</pubDate><author>xiaoZ1712</author></item><item><title>Jayden-runner starred y_project/RuoYi</title><description></description><link></link><guid isPermaLink="false">1510053231317590016</guid><pubDate>Fri, 29 May 2026 14:52:25 GMT</pubDate><author>Jayden-runner</author></item><item><title>xiaotaozilove starred y_project/RuoYi</title><description></description><link></link><guid isPermaLink="false">1510049180643295232</guid><pubDate>Fri, 29 May 2026 14:36:20 GMT</pubDate><author>xiaotaozilove</author></item><item><title>changming1128 starred y_project/RuoYi</title><description></description><link></link><guid isPermaLink="false">1510023223190614016</guid><pubDate>Fri, 29 May 2026 12:53:11 GMT</pubDate><author>changming1128</author></item><item><title>joker-apps forked y_project/RuoYi</title><description></description><link>https://gitee.com/joker-apps/RuoYi.git</link><guid isPe