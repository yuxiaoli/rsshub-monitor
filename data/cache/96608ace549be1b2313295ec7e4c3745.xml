    &lt;dl class=&quot;media_pic&quot;&gt;
     &lt;dt&gt;&lt;img data-src=&quot;https://img.caixin.com/2018-11-10/1541836022921532_840_560.jpg&quot; class=&quot;cx-img-loader&quot; src=&quot;https://img.caixin.com/2018-11-10/1541836022921532_840_560.jpg&quot; referrerpolicy=&quot;no-referrer&quot;&gt;&lt;/dt&gt;
