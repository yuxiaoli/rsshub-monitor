                &lt;div class=&quot;absolute right-[8px] top-[8px] max-h-max cursor-pointer bff-inline-image-expand-icon pointer-events-none&quot;&gt;
                  &lt;div class=&quot;rounded-full bg-overlay-secondary p-[4px] &quot;&gt;
                    &lt;svg width=&quot;22&quot; height=&quot;22&quot; viewBox=&quot;0 0 20 21&quot; fill=&quot;none&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;
